{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": [
            "esnext"
        ],
        "outDir": "dist",
        "paths": {
            "@controllers/*": ["./src/controllers/*"],
            "@models/*": ["./src/models/*"],
            "@constants": ["./src/constants"],
            "@constants/*": ["./src/constants/*"],
            "@utils/*": ["./src/utils/*"],
            "@package/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*"
    ]
}
