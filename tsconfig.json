{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "lib": [
            "esnext"
        ],
        "outDir": "dist"
    },
    "include": [
        "src/**/*"
    ]
}
